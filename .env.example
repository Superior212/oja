# Moove API
# Create a key in the Moove Dashboard with the Moove Receive Agent.
# The plaintext key is shown once at creation and cannot be retrieved again.
# Scopes needed: payment_link:create, payment_link:read
MOOVE_API_KEY=

# Override only if you are pointed at a non-production environment.
MOOVE_API_BASE=https://api.moove.xyz

# Decimals of your Moove settlement token. USDC is 6.
# Payment link amounts must match this precision.
SETTLEMENT_TOKEN_DECIMALS=6

# WhatsApp Business Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Server
PORT=3000

# Reconciliation
# How long to keep polling an open order before giving up, in minutes.
RECONCILE_TTL_MINUTES=60
